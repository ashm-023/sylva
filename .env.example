# Sylva environment variables
# Copy this to .env and fill in your keys
# NEVER commit .env to git
#
# Vercel: add the same keys in Project → Settings → Environment Variables.
# Do NOT prefix secrets with VITE_ — anything VITE_* is exposed in the browser.

# --- Server only (safe on Vercel / Render / Docker) ---
OPENTOPO_API_KEY=your_opentopography_key_here

# Gemini — used by /farm/recommendations RAG plan generation
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override (default tries gemini-3.5-flash-lite, then other Flash models)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Required in production for ESP32 → /api/v1/sensors/ingest
SENSOR_INGEST_TOKEN=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the API cross-origin.
# Same-origin Vercel deploys (UI + API together) don't need this for /api fetches.
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Hide OpenAPI docs in production
# ENABLE_API_DOCS=0

# Force API-only mode (no static file serving) — set automatically on Vercel
# SYLVA_API_ONLY=1

# Google Earth Engine (run `earthengine authenticate` once in terminal)
# No key needed here — uses ~/.config/earthengine/credentials

# --- Vercel (website) ---
# Only the public upstream URL — NO API keys on Vercel
# API_UPSTREAM_URL=https://your-app.onrender.com

# --- Frontend (Vite) — public only ---
# Leave unset in production so the UI calls same-origin /api/v1
# VITE_API_BASE=/api/v1

# --- Render → Vercel redirect ---
# When set on Render, browsers are 301'd to this URL (path preserved).
# /health is not redirected so Render health checks still pass.
# SITE_REDIRECT_URL=https://sylvagro.vercel.app/hardware

# --- Nature arm (optional) ---
# Free OpenAlex key for the map harvester
# OPENALEX_API_KEY=
# Crossref polite-pool contact
# CROSSREF_MAILTO=
# Embedding model for the nature search index
# NATURE_EMBED_MODEL=gemini-embedding-2
